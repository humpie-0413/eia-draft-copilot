# EIA Draft Copilot 백엔드 환경변수 예제
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.

# ── 데이터베이스 ──────────────────────────────────
# PostgreSQL + PostGIS 연결 URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eia_copilot

# ── 공공데이터포털 API 키 ─────────────────────────
# https://www.data.go.kr/ 에서 발급받은 인코딩 키
# 아래 4개 API에서 공유 사용:
#   - 에어코리아 대기오염정보 (keco_air)
#   - 국립환경과학원 수질 DB (water_info)
#   - 국립환경과학원 토양측정망 (soil_info)
#   - 기상청 종관기상관측 ASOS (kma_weather)
DATA_GO_KR_API_KEY=

# ── AI API 키 (선택) ──────────────────────────────
# MVP는 LLM_MODE=none으로 동작하므로 필수가 아님
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── 기타 설정 ─────────────────────────────────────
DEBUG=false
CONNECTOR_TIMEOUT=30

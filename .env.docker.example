# ============================================================
# EIA Draft Copilot — Docker Compose 환경변수
# 이 파일을 .env로 복사한 뒤 값을 설정하세요
# ============================================================

# --- 데이터베이스 ---
POSTGRES_DB=eia_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- 포트 ---
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80

# --- 백엔드 ---
CORS_ORIGINS=http://localhost:3000
DEBUG=false
CONNECTOR_TIMEOUT=60
LLM_ADAPTER=none

# --- API 키 (필수: 공공데이터포털) ---
DATA_GO_KR_API_KEY=
VWORLD_API_KEY=

# --- API 키 (선택: LLM) ---
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- 프론트엔드 ---
NEXT_PUBLIC_API_URL=http://localhost:8000
